{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 5am on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "matchPackagePatterns": [
        "^signal-desktop",
        "^forensicnomicon",
        "^chromium-safestorage"
      ],
      "groupName": "fleet crates"
    }
  ],
  "minimumReleaseAge": "21 days",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": [
      "security"
    ],
    "prPriority": 10
  }
}
